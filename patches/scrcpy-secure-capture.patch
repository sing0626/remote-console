+++ b/server/src/main/java/com/genymobile/scrcpy/Server.java
@@ -278,13 +278,24 @@ public final class Server {
 
     @SuppressWarnings("deprecation")
     private static void dropRootPrivileges() {
+        if (Boolean.getBoolean("marble.secure_capture") && Os.getuid() != 0) {
+            throw new SecurityException("Marble secure capture must be root-launched");
+        }
         try {
             if (Os.getuid() == 0) {
                 // Copy-paste does not work with root user
                 // <https://github.com/Genymobile/scrcpy/issues/6224>
-                Os.setuid(2000);
+                // Marble's authenticated on-device root transport can request a
+                // secure mirror. Switch this process only to the Android system
+                // identity, which can create a SECURE display and has a valid
+                // package/UID attribution for clipboard and audio services.
+                boolean secureMirror = Boolean.getBoolean("marble.secure_capture");
+                Os.setuid(secureMirror ? 1000 : 2000);
             }
         } catch (Exception e) {
+            if (Boolean.getBoolean("marble.secure_capture")) {
+                throw new IllegalStateException("Cannot establish secure mirror identity", e);
+            }
             Ln.w("Cannot set UID", e);
         }
     }
